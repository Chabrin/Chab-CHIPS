### Ignore application storage directories (keep templates/seeds out if needed)
# Ignore all storage app files (except if you intentionally keep some, add explicit allow rules)
/storage/app/

# Framework runtime files
/storage/framework/

# Sessions, cache, compiled views and testing artifacts
/storage/framework/sessions/
/storage/framework/cache/
/storage/framework/views/
/storage/framework/testing/

# Logs and debugbar
/storage/logs/
/storage/debugbar/

# If you need to keep specific seed or template files under storage/app, add
# a negation rule after these entries, e.g.:
# !/storage/app/keep-this-file.php

